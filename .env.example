# Production domain (compose.prod.yaml): HTTPS, links, webhook. Example: universe.uz
DOMAIN=

# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=universe
POSTGRES_USER=universe
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://universe:change-me@localhost:15432/universe

REDIS_URL=redis://localhost:16379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Object storage (MinIO / S3). Leave USE_S3=false to store files on local disk.
USE_S3=false
S3_BUCKET=universe-files
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Public URL of the site (used in password-reset emails).
PUBLIC_ORIGIN=http://localhost:5173

# Google sign-in (Google Cloud Console > OAuth client, type "Web"). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Shown on the privacy policy and terms pages. Set both before launch.
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=
# Bot username without @, for the link on the FAQ page (optional).
VITE_TELEGRAM_BOT_USERNAME=

# Email. "console" prints emails to the log; "smtp" sends them with the SMTP_* values.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=the address, SMTP_PASSWORD=a 16-letter app password
# (Google account > Security > 2-Step Verification > App passwords), and DEFAULT_FROM_EMAIL
# must use that same address. Check with: python manage.py sendtestemail you@example.com
MAIL_BACKEND=console
DEFAULT_FROM_EMAIL=jichcha <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Per-IP limit for login/register/password reset.
# THROTTLE_AUTH=10/15m
# Conversion starts per minute.
# THROTTLE_TASK_CREATE=20/min      # per account / guest browser
# THROTTLE_TASK_CREATE_IP=120/min  # all guests behind one IP together
# Other guest requests (status polling): per browser, and per IP for everyone behind it.
# THROTTLE_ANON=120/min
# THROTTLE_ANON_IP=1200/min

# LibreOffice binary for office -> PDF (Docker image: soffice; macOS: the path below).
SOFFICE_BINARY=/Applications/LibreOffice.app/Contents/MacOS/soffice

# ARCHIVE_MAX_ENTRIES=1000
# ARCHIVE_MAX_UNPACKED_MB=1024

# Error tracking (optional): https://sentry.io project DSN. Leave empty to disable.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Health check fails (HTTP 503) below this much free disk on the media volume.
# HEALTH_MIN_FREE_MB=2048

# Docker builds: optional faster Debian mirror (security updates still come from Debian).
DEBIAN_MIRROR=

# Telegram bot (aiogram). Token from @BotFather; never commit it.
TELEGRAM_BOT_TOKEN=
# Shared secret between the bot and the backend's internal API: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_API_SECRET=
# Empty = long polling (local). Production: public HTTPS URL, e.g. https://example.uz/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Random string; Telegram sends it back in a header so the webhook ignores forged updates.
TELEGRAM_WEBHOOK_SECRET=

# Server alerts on Telegram (manage.py monitor). Add the bot to the team chat, send /id there, put the id here.
ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM_TOKEN=          # defaults to TELEGRAM_BOT_TOKEN
# ALERT_QUEUE_MAX=100            # alert when a queue holds more tasks than this
# ALERT_ERROR_RATE=0.3           # ...or when more than 30% of the last 15 minutes' tasks failed

# Cloudflare Turnstile robot check on sign-up and password reset (optional; both or neither).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Admin security -----------------------------------------------------------------------------
# Staff must turn on two-step sign-in (account page) before the admin panel answers them.
# Development settings default to false; production to true. Don't set false in production.
# STAFF_REQUIRE_2FA=true
# Django's built-in /admin/ has no two-step sign-in: off in production unless a path is set.
# Keep the admin/ prefix and add something hard to guess, e.g. admin/k3x9-console/
# DJANGO_ADMIN_URL=

# --- Temporary hosting: site on Vercel, API here through ngrok (compose.tunnel.yaml, docs/VERCEL.md) ---
# 32+ random characters; the same value goes into the Vercel project's env vars.
EDGE_SECRET=
# From dashboard.ngrok.com: "Your Authtoken" and your free static domain (without https://).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# The site's address on Vercel, e.g. https://jichcha-uz.vercel.app
VERCEL_ORIGIN=

# --- Contacts ---------------------------------------------------------------------------------
# Suggestions and complaints from /feedback are emailed here (needs SMTP above).
FEEDBACK_EMAIL=jichchainfo@gmail.com
# Footer Telegram link, username without @ (default: jichcha_info). VITE_CONTACT_EMAIL above
# defaults to jichchainfo@gmail.com.
VITE_TELEGRAM_USERNAME=
