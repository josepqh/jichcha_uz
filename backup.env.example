# Off-site copy of the daily database dumps (copy to backup.env; never commit backup.env).
# Any rclone backend works; this example is S3-compatible storage behind an encrypting "crypt" layer,
# because the dumps contain emails and password hashes.
BACKUP_REMOTE=secure:
BACKUP_REMOTE_KEEP_DAYS=30

RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Other
RCLONE_CONFIG_S3_ENDPOINT=https://storage.example.uz
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=

RCLONE_CONFIG_SECURE_TYPE=crypt
RCLONE_CONFIG_SECURE_REMOTE=s3:jichcha-backups
# rclone obscure '<a long random passphrase>'  (keep the plain passphrase in a password manager)
RCLONE_CONFIG_SECURE_PASSWORD=
