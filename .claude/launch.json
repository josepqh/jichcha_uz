{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "celery",
        "--workdir",
        "backend",
        "-A",
        "config",
        "worker",
        "-Q",
        "light,office,ebook,maintenance",
        "-c",
        "2",
        "-l",
        "info"
      ]
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
